{
  "name": "tirith-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:widget": "node scripts/build-widget.mjs",
    "build": "npm run build:widget && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build:widget && tsx src/server.ts",
    "mock": "tsx mock-backend.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
