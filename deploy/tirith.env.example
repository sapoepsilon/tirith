# Copy to tirith.env on the LXC (/opt/tirith/deploy/tirith.env, chmod 600).
# NO secret values in this file. Secrets are generated/injected directly on the box
# (see README "Secrets"). The MCP server has its own env file: mcp.env (from mcp.env.example).
# On the box, deploy/migrate-env.sh splits this file into /etc/tirith/backend.env, mcp.env and
# dashboard.env; only backend.env keeps the GitHub/LLM secrets.
# Keep comments on their own lines (no inline "# ..." after values).

# --- LLM (self-hosted DeepSeek on CT160 llm-pve3) ---
# stub = deterministic canned outputs, no network. Set to openai for the real DeepSeek.
TIRITH_LLM_PROVIDER=stub
TIRITH_LLM_BASE_URL=http://192.168.50.160:8010/v1
# Empty = first id from /v1/models
TIRITH_LLM_MODEL=
# Injected by the owner on the box; never commit a value.
TIRITH_LLM_API_KEY=
TIRITH_LLM_TIMEOUT=600
TIRITH_LLM_MAX_TOKENS=16384

# --- GitHub (fix PRs go to the fork only) ---
# Injected by the owner on the box; never commit a value.
TIRITH_GITHUB_TOKEN=
TIRITH_PR_REPOS=sapoepsilon/tirith-demo-target

# --- Access control ---
# Bearer token for /api/* and the WebSocket (openssl rand -hex 24). Also copied into mcp.env.
# The backend refuses to start without it (TIRITH_ALLOW_NO_AUTH=1 is for local dev only; never here).
TIRITH_API_TOKEN=
# Comma list of exact browser origins allowed by CORS. Empty = no CORS (the dashboard proxies server side).
TIRITH_CORS_ORIGINS=
# Set to 1 to permit PUT /api/mode {mode: autonomous}. Empty = autonomous mode is refused (403).
TIRITH_ALLOW_AUTONOMOUS=
# Dashboard basic auth (interpolated into the dashboard service only). Leave both empty for a single-operator
# install behind the tunnel: the dashboard is then open, the backend token stays server side.
TIRITH_DASH_USER=
TIRITH_DASH_PASSWORD=

# --- Autonomous analyst ---
# Set to 1 to expose POST /api/analyst/runs (the model plans; fixed scope-checked tools execute).
TIRITH_ALLOW_ANALYST=
# Per-run limits: model tool calls (default 8, hard max 24) and wall-clock seconds (default 600).
TIRITH_ANALYST_MAX_STEPS=8
TIRITH_ANALYST_SECONDS=600
# Set to 1 to allow POST /api/evidence/screenshot (pulls a Chromium image once).
TIRITH_ALLOW_SHOTS=
TIRITH_CHROME_IMAGE=zenika/alpine-chrome:latest

# --- Backend ---
# Data dir (native install: owned by the `tirith` service user; the backend unit may write only here).
TIRITH_DATA_DIR=/opt/tirith-data
TIRITH_SCAN_TIMEOUT=900

# --- Scanner CLIs (native install) ---
# Every scanner runs as a plain binary from the unit PATH; a bare name is enough unless the binary
# lives elsewhere. Point these at full paths to pin a specific build.
# TIRITH_SEMGREP_BIN=semgrep
# TIRITH_GITLEAKS_BIN=gitleaks
# TIRITH_TRIVY_BIN=trivy
# TIRITH_NIKTO_BIN=nikto
# ZAP is a script, not a scanner binary; it is only used when a check needs it.
# TIRITH_ZAP_SCRIPT=/usr/share/zaproxy/zap-baseline.py
# nmap arguments in front of the target (connect scan: no raw sockets needed).
# TIRITH_NMAP_ARGS=-sT -T4 --host-timeout 90s
# Arguments for nikto.
# TIRITH_NIKTO_ARGS=-ask none
# Set to 1 to force the stdlib-only lab processes even if a container runtime appears later.
TIRITH_NO_DOCKER=1

# --- Dashboard (inlined at build time; rebuild after changing) ---
# The dashboard reaches the backend server side on 127.0.0.1:8000; no public backend URL.
NEXT_PUBLIC_TIRITH_MOCK=
