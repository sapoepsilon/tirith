# Copy to mcp.env on the LXC (/opt/tirith/deploy/mcp.env, chmod 600).
# Env for the MCP server container ONLY. Never put GitHub/LLM secrets here.
# Keep comments on their own lines (no inline "# ..." after values).

# Same value as TIRITH_API_TOKEN in tirith.env (the backend bearer token).
TIRITH_API_TOKEN=
# MCP is served at /mcp/<secret>; plain /mcp returns 404 (openssl rand -hex 24).
TIRITH_MCP_PATH_SECRET=
# Full public MCP URL incl. the secret path, e.g. https://tirith.example.com/mcp/<secret>
TIRITH_MCP_PUBLIC_URL=
# e.g. https://tirith.example.com once the Cloudflare tunnel exists
TIRITH_WIDGET_DOMAIN=
# Public dashboard origin, used to return clickable report links from ChatGPT.
TIRITH_DASHBOARD_PUBLIC_URL=https://tirith-dash.mansurov.dev
# OpenAI apps domain-verification token, only if OpenAI asks for one
TIRITH_OPENAI_CHALLENGE=
