# --- server-only (never exposed to the browser) ---
# Backend base URL as seen from the Next.js server (REST proxy + live events relay)
TIRITH_BACKEND_INTERNAL_URL=http://localhost:8000
# Bearer token the backend requires (Authorization: Bearer ...); added server side by the proxy
TIRITH_API_TOKEN=
# Basic auth for the dashboard itself; if unset the dashboard is open in `next dev` only and refuses in production
TIRITH_DASH_USER=
TIRITH_DASH_PASSWORD=

# --- client ---
# 1 = always use the scripted demo replay
NEXT_PUBLIC_TIRITH_MOCK=0
